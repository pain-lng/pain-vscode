{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pain",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#classes"
    },
    {
      "include": "#types"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.pain",
          "match": "\\b(if|else|for|in|while|break|continue|return)\\b"
        },
        {
          "name": "keyword.declaration.pain",
          "match": "\\b(fn|let|var|class|import)\\b"
        },
        {
          "name": "keyword.other.async.pain",
          "match": "\\b(async|await)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.pain",
          "match": "\\b(int|str|float32|float64|bool|list|array|map|Tensor|dynamic)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.integer.pain",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.float.pain",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "string.quoted.double.pain",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pain",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.triple.pain",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.pain",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.language.boolean.pain",
          "match": "\\b(True|False)\\b"
        },
        {
          "name": "constant.language.null.pain",
          "match": "\\bNone\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pain",
          "match": "(==|!=|<=|>=|->|&&|\\|\\||[+\\-*/%=<>!])"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pain",
          "match": "#.*$"
        },
        {
          "name": "comment.block.documentation.pain",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "comment.block.documentation.pain",
              "match": "."
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.pain",
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.function.pain"
            }
          }
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "entity.name.type.class.pain",
          "match": "\\bclass\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.class.pain"
            }
          }
        }
      ]
    }
  },
  "scopeName": "source.pain"
}

