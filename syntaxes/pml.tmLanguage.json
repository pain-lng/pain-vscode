{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PML",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#null"
    },
    {
      "include": "#list_items"
    },
    {
      "include": "#keys"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pml",
          "match": "#.*$"
        }
      ]
    },
    "keys": {
      "patterns": [
        {
          "name": "entity.name.tag.pml",
          "match": "^(\t*)([a-zA-Z_][a-zA-Z0-9_]*)\\s*:"
        }
      ]
    },
    "list_items": {
      "patterns": [
        {
          "name": "punctuation.definition.list.begin.pml",
          "match": "^\\s*-\\s+"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pml",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pml",
              "match": "\\\\[nrt\\\\\"']"
            }
          ]
        },
        {
          "name": "string.quoted.single.pml",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pml",
              "match": "\\\\[nrt\\\\\"']"
            }
          ]
        },
        {
          "name": "string.unquoted.pml",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.pml",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.float.pml",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.pml",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "null": {
      "patterns": [
        {
          "name": "constant.language.null.pml",
          "match": "\\bnull\\b"
        }
      ]
    }
  },
  "scopeName": "source.pml"
}

